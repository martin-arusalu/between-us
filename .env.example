# Copy this file to .env. Only the Node server reads it.
# Leave the key blank for the clearly labeled practice bot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Only private word guesses use this smaller model. Dialogue keeps OPENAI_MODEL.
OPENAI_GUESSER_MODEL=gpt-5.4-nano

# Optional Estonian speech for solo mode. Audio starts on; toggle it off in the game.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# Optional: three comma-separated voice IDs. Otherwise available default voices are used.
ELEVENLABS_VOICE_IDS=h4Y9LTN9ES7xSQRnyhC9,xd3ufyLcuKKZZXDZO9H7,3jMasSOd05IQvSnHSd6B

# Listen on your local network so friends can join from their phones.
PORT=5173
HOST=0.0.0.0

# Hosted backend deployment (optional for local play).
SUPABASE_PROJECT_REF=jqxtqditbnuggbkronng
SUPABASE_ACCESS_TOKEN=
# These two values are PUBLIC and are included in the GitHub Pages build.
PUBLIC_SUPABASE_URL=https://jqxtqditbnuggbkronng.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: comma-separated browser origins; defaults to * for a public prototype.
ALLOWED_ORIGINS=*
